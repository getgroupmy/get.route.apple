# Copy to .env and fill in. Never commit .env.

# The secret your app sends in the X-Route-Key header. Make one with:
#   openssl rand -hex 32
# (or reuse GET.route's key so your app sends one key to all of them)
ROUTE_API_KEY=

# GET.route's Docker network, so GET.route's tunnel can reach this container.
# Find it with:
#   sudo docker inspect get-route-tunnel --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
GET_ROUTE_NETWORK=

# Only for its own tunnel (docker compose --profile own-tunnel up -d):
# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel > Docker,
# the token after --token. Leave empty when using GET.route's tunnel.
TUNNEL_TOKEN=

# Port on the NAS's LAN address (http://NAS_IP:8085). Not opened on the router.
LAN_PORT=8085

# Memory cap for the container (Chromium + API). 1200m suits a 2 GB DS224+;
# with more RAM you can raise it together with TABS.
MEM_LIMIT=1200m

# Lookups answered at the same time (one browser tab each).
TABS=2

# Seconds a lookup waits for a free tab before a 503, and for Apple's answer.
WAIT_FOR_BROWSER=10
LOOKUP_TIMEOUT=15

# Answer a repeat of the same trip from memory for this many seconds (0 = off).
CACHE_SECONDS=60

# Start Chromium with the container (1) or on the first lookup (0).
WARM_ON_START=1

# Only if lookups stop working (see README.md, "When a lookup fails"). Empty =
# DuckDuckGo's directions page, and Apple's answer from apple-mapkit.com.
SEARCH_URL=
CAPTURE_PATTERN=
