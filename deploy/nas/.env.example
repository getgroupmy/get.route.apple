# GET.route Apple Maps on the NAS (applemap2.getcdn.link). Copy to .env and
# fill in. Type the secrets on the NAS; never send them through chat, email or git.

# The owner's way in to the console at /admin (at least 24 characters). Make it
# on the NAS without showing it (README.md, step 3).
APPLEMAP_ADMIN_TOKEN=
APPLEMAP_PUBLIC_URL=https://applemap2.getcdn.link

# Apple Developer account (README.md, "Get an Apple Maps key"): the Team ID
# (Membership details) and the Key ID of the Maps key. Put the key file itself
# in deploy/nas/secrets/apple_maps.p8.
APPLE_TEAM_ID=
APPLE_MAPS_KEY_ID=

# GET.route's Docker network NAME (e.g. get-route_default, not a long ID):
#   sudo docker inspect get-route-tunnel --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
GET_ROUTE_NETWORK=

# Place names are looked up near this point (Kuala Lumpur). Empty = anywhere.
SEARCH_LOCATION=3.1390,101.6869
LANGUAGE=en-US

# Optional: the old single key. On start it becomes an app in the console, so
# callers still sending it keep working. Remove it once they have their own keys.
ROUTE_API_KEY=

# Starting values: once the console is running, change them in its Settings.
# Apple's 25,000 calls a day are shared with the Mac mini: when the Mac is
# live, set this NAS to 4,500 (Settings) and the Mac to 20,000.
DAILY_LIMIT=24000
MAX_PER_MINUTE=20

# Port on the NAS's LAN address (http://NAS_IP:8085). Not opened on the router.
LAN_PORT=8085
MEM_LIMIT=256m

# Only for its own tunnel (docker compose --profile own-tunnel up -d).
TUNNEL_TOKEN=
