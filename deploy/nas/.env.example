# Copy to .env and fill in. Never commit .env.

# The secret your app sends in the X-Route-Key header. Make one with:
#   openssl rand -hex 32
# (or reuse GET.route's key so your app sends one key to all of them)
ROUTE_API_KEY=

# Apple Developer account (see README.md, "Get an Apple Maps key"):
# the Team ID (Membership details) and the Key ID of the Maps key. Put the
# key file itself in deploy/nas/secrets/apple_maps.p8.
APPLE_TEAM_ID=
APPLE_MAPS_KEY_ID=

# GET.route's Docker network NAME (e.g. get-route_default, not a long ID),
# so GET.route's tunnel can reach this container. Find it with:
#   sudo docker inspect get-route-tunnel --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
GET_ROUTE_NETWORK=

# Place names are looked up near this point (lat,lng). Kuala Lumpur, so
# "Beranang" means the one in Selangor. Empty = anywhere.
SEARCH_LOCATION=3.1390,101.6869

# Language of road names in answers.
LANGUAGE=en-US

# Only for its own tunnel (docker compose --profile own-tunnel up -d):
# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel > Docker,
# the token after --token. Leave empty when using GET.route's tunnel.
TUNNEL_TOKEN=

# Port on the NAS's LAN address (http://NAS_IP:8085). Not opened on the router.
LAN_PORT=8085

# Memory cap for the container (no browser: it needs about 60 MB).
MEM_LIMIT=256m

# Apple allows 25,000 Maps Server API calls a day for the whole team.
# Answer a repeat of the same trip from memory for this many seconds (0 = off);
# points within ~100 m count as the same trip.
CACHE_SECONDS=1800
# While calls are paused (cap reached or Apple's 429), answer from a cached
# trip up to this old, marked "stale": true (0 = never).
STALE_SECONDS=21600
DAILY_LIMIT=24000        # most calls per UTC day (keep under 25,000; 0 = no cap)
MAX_PER_MINUTE=20        # most calls a minute; extra get a 503 at once (0 = no cap)
QUOTA_PAUSE=900          # pause after Apple's 429 when it doesn't say how long
