# GET.route Apple Maps on the Mac mini (applemap.getcdn.link). Copy to .env in
# this folder (README.md makes it for you). Never send these through chat,
# email or git.

# The owner's way in to this Mac's console (at least 24 characters): openssl rand -hex 32
APPLEMAP_ADMIN_TOKEN=
APPLEMAP_PUBLIC_URL=https://applemap.getcdn.link

# The port on this Mac that the Cloudflare Tunnel sends applemap.getcdn.link to.
APPLEMAP_PORT=8400

# The SAME Apple key as the NAS: Team ID, Key ID, and the key file at
# deploy/mac/secrets/apple_maps.p8 (start.sh points APPLE_MAPS_KEY_FILE there).
APPLE_TEAM_ID=
APPLE_MAPS_KEY_ID=

SEARCH_LOCATION=3.1390,101.6869
LANGUAGE=en-US

# Starting values: change them in the console's Settings. The Mac is the first
# Apple Maps server, so it gets most of Apple's 25,000 a day (the NAS 4,500).
DAILY_LIMIT=20000
MAX_PER_MINUTE=20
