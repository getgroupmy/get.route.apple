# Copy to .env and fill in. Never commit .env.

# The SAME values as the NAS's deploy/nas/.env, so GET.ride uses one key for
# both and both sign with the same Apple Maps key (copy secrets/apple_maps.p8 too).
ROUTE_API_KEY=
APPLE_TEAM_ID=
APPLE_MAPS_KEY_ID=

# This Mac's own Cloudflare Tunnel: Zero Trust > Networks > Tunnels > Create a
# tunnel > Cloudflared > Docker, the token after --token (see README.md).
TUNNEL_TOKEN=

# Place names are looked up near this point (Kuala Lumpur). Empty = anywhere.
SEARCH_LOCATION=3.1390,101.6869
LANGUAGE=en-US

# Apple allows 25,000 calls a day for the whole team, shared with the NAS.
# The Mac is primary, so it gets most of it; set the NAS's DAILY_LIMIT to 4500
# so the two together stay under 25,000.
DAILY_LIMIT=20000
MAX_PER_MINUTE=20        # extra lookups in a minute get a 503 at once (0 = no cap)
CACHE_SECONDS=1800       # repeat trips from memory for 30 min
STALE_SECONDS=21600      # while paused, answer recent trips (up to 6 h) marked "stale"
QUOTA_PAUSE=900          # pause after Apple's 429 when it doesn't say how long

# Port on the Mac itself only (http://localhost:8085), for checks.
LOCAL_PORT=8085
MEM_LIMIT=256m
